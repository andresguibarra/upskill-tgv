<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft.Testing.Extensions.CodeCoverage: se excluye el código generado (migraciones de EF Core y source generators en obj/). -->
<Configuration>
  <CodeCoverage>
    <Sources>
      <Exclude>
        <Source>.*[\\/]Migrations[\\/].*</Source>
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
